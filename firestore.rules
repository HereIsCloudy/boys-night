rules_version = '2';

// BOYS NIGHT — Firestore rules.
//
// The game is entirely client-side, so a determined person can write whatever
// they like to their own document. These rules are not trying to stop that;
// they stop casual tampering and keep the boards from being destroyed by a
// single bad write. Real validation would need Cloud Functions, which requires
// the Blaze plan.
//
// The important guarantees:
//   - you can only ever write your OWN document
//   - lifetime counters can never decrease
//   - values must be numbers within sane ceilings
//   - names are length-limited so nobody can inject a wall of text

service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{playerId} {

      // Boards are public — anyone can read the rankings.
      allow read: if true;

      allow create: if isOwner(playerId) && validShape() && startsAtZeroOrAbove();
      allow update: if isOwner(playerId) && validShape() && monotonic();
      allow delete: if isOwner(playerId);

      function isOwner(id) {
        return request.auth != null && request.auth.uid == id;
      }

      function data() { return request.resource.data; }
      function prior() { return resource.data; }

      function num(field, maxValue) {
        return data()[field] is number
          && data()[field] >= 0
          && data()[field] <= maxValue;
      }

      function validShape() {
        return data().name is string
          && data().name.size() <= 18
          && validSave()
          && num('totalSpins',        10000000000)
          && num('totalWagered',      1000000000000)
          && num('peakBalance',       1000000000000000)
          && num('biggestWinAmount',  1000000000000000)
          && num('biggestMultiplier', 15000)
          && num('longestWinStreak',  100000)
          && num('megaWins',          1000000)
          && num('achievements',      500);
      }

      // Cloud save blob. Optional (guests never write one), and capped well
      // under the 1 MiB document limit so nobody can park junk in here.
      function validSave() {
        return !('save' in data())
          || (data().save is string && data().save.size() <= 200000);
      }

      // Lifetime totals only ever go up. This is what stops someone
      // "resetting" into a better position or fat-fingering a rollback.
      function monotonic() {
        return data().totalSpins        >= prior().totalSpins
          && data().totalWagered        >= prior().totalWagered
          && data().peakBalance         >= prior().peakBalance
          && data().biggestWinAmount    >= prior().biggestWinAmount
          && data().biggestMultiplier   >= prior().biggestMultiplier
          && data().longestWinStreak    >= prior().longestWinStreak
          && data().megaWins            >= prior().megaWins;
      }

      function startsAtZeroOrAbove() {
        return data().totalSpins >= 0;
      }
    }

    // Friend requests. One doc per directed pair, id "<from>_<to>", so a
    // duplicate request is a same-id overwrite rather than spam. The sender
    // creates it, only the recipient can flip it to accepted, either side can
    // delete (decline, cancel, or clean up after acceptance).
    match /friend_requests/{reqId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.resource.data.fromUid
        && reqId == request.resource.data.fromUid + '_' + request.resource.data.toUid
        && request.resource.data.status == 'pending'
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 18
        && request.resource.data.fromTag is string
        && request.resource.data.fromTag.size() <= 4
        && request.resource.data.toName is string
        && request.resource.data.toName.size() <= 18
        && request.resource.data.toTag is string
        && request.resource.data.toTag.size() <= 4;

      // Accepting is the only edit that exists, and only the recipient can do
      // it. Pinning from/to stops an "accept" quietly rewriting who it's from.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.toUid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;

      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);
    }

    // Nothing else is writable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
